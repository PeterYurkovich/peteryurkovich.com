---
const { pageTitle } = Astro.props;
---

<a
    href="/"
    style={`${pageTitle === "Peter - Howdy" ? "text-decoration: underline" : ""}`}
    class="link">Home</a
>
<a
    href="/projects/"
    style={`${pageTitle === "Peter - Projects" ? "text-decoration: underline" : ""}`}
    class="link">Projects</a
>
<a
    href="/resume/"
    style={`${pageTitle === "Peter - Resume" ? "text-decoration: underline" : ""}`}
    class="link">Resume</a
>
